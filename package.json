{
  "name": "mispar",
  "version": "1.0.0",
  "description": "Hebrew gematria with all the classical methods — hechrachi, gadol, katan, siduri, katan mispari, perati, meshulash, kidmi, bone'eh, ha'akhor, milui, atbash, albam. Zero dependencies.",
  "keywords": [
    "gematria",
    "gimatria",
    "hebrew",
    "mispar",
    "atbash",
    "albam",
    "milui",
    "numerology",
    "torah",
    "kabbalah",
    "judaica",
    "niqqud"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/mispar.git"
  },
  "bugs": "https://github.com/moshejs/mispar/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
